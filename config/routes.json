  "roles": [
    {
      "id": "ds-library-reader",
      "path": "agents/ds-library-reader.toml",
      "when": "Use for a focused inventory of unfamiliar APIs, variants, token consumers or composition across the selected project. Skip when facts are already clear and local."
    },
    {
      "id": "ds-researcher",
      "path": "agents/ds-researcher.toml",
      "when": "Use when a substantive open design/engineering question needs independent primary-source research or comparison. Do not re-research settled decisions."
    },
    {
      "id": "ds-reviewer",
      "path": "agents/ds-reviewer.toml",
      "when": "Use for an independent bounded review of a meaningful change against its Spec and evidence. Do not turn a small editorial fix into mandatory multi-agent work."
    }
  ],
