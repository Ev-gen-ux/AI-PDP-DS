{
  "xl": {
    "fontFamily": {
      "base": { "$value": "Inter, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "fontWeight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semiBold": { "$value": "600", "$type": "fontWeight" }
    },
    "fontSize": {
      "heading": {
        "h1": { "$value": "40px", "$type": "dimension" },
        "h2": { "$value": "32px", "$type": "dimension" }
      },
      "text": {
        "base": { "$value": "16px", "$type": "dimension" },
        "small": { "$value": "14px", "$type": "dimension" }
      },
      "component": {
        "base": { "$value": "16px", "$type": "dimension" },
        "small": { "$value": "14px", "$type": "dimension" }
      }
    },
    "lineHeight": {
      "heading": {
        "h1": { "$value": "48px", "$type": "dimension" },
        "h2": { "$value": "40px", "$type": "dimension" }
      },
      "text": {
        "base": { "$value": "24px", "$type": "dimension" },
        "small": { "$value": "20px", "$type": "dimension" }
      },
      "component": {
        "base": { "$value": "24px", "$type": "dimension" },
        "small": { "$value": "20px", "$type": "dimension" }
      }
    }
  }
}
