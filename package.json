{
  "name": "design-system-developer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tools and process for independent design-system projects",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "prepare": "node scripts/environment/prepare-hooks.js",
    "env:task": "node scripts/environment/journal.js",
    "env:check": "node scripts/environment/check.js",
    "env:route": "node scripts/environment/route.js",
    "test:tooling": "node --test scripts/tests/*.test.js",
    "test": "npm run test:tooling",
    "lint": "eslint scripts templates/project/scripts eslint.config.js --max-warnings 0",
    "format:check": "prettier --check \"**/*.{js,json,md,yml}\" \"skills/**/SKILL.md\"",
    "format": "prettier --write \"**/*.{js,json,md,yml}\" \"skills/**/SKILL.md\"",
    "env:project": "node scripts/environment/projects.js",
    "env:primitives": "node scripts/environment/primitives.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "husky": "9.1.7"
  }
}
