{
  "name": "@ev-gen-ux/ai-pdp-ds",
  "version": "0.10.0",
  "description": "AI-PDP-DS — design system library: React + TypeScript + styled-components, synced with Figma via Code Connect and Variables REST API.",
  "license": "MIT",
  "author": "Ev-gen-ux",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ev-gen-ux/AI-PDP-DS.git"
  },
  "homepage": "https://github.com/Ev-gen-ux/AI-PDP-DS#readme",
  "bugs": "https://github.com/Ev-gen-ux/AI-PDP-DS/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.cjs"
    },
    "./theme/variables.css": "./dist/theme/variables.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "tokens:build": "node ./scripts/style-dictionary.build.js",
    "tokens:pull": "node ./scripts/figma-tokens-pull.js",
    "tokens:push": "node ./scripts/figma-tokens-push.js",
    "tokens:watch": "style-dictionary build --config ./scripts/style-dictionary.config.js --watch",
    "dev": "vite",
    "build": "npm run tokens:build && tsc -p tsconfig.build.json && vite build",
    "build:lib": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "chromatic": "chromatic --exit-zero-on-changes",
    "figma:publish": "figma connect publish",
    "figma:unpublish": "figma connect unpublish",
    "figma:create": "figma connect create",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "npm run build && changeset publish",
    "prepare": "husky",
    "preinstall": "npx only-allow npm"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "styled-components": "^6.0.0"
  },
  "dependencies": {
    "@fontsource/geologica": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.1.0",
    "@tokens-studio/sd-transforms": "^2.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@figma/code-connect": "^1.4.4",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "axios": "^1.7.9",
    "babel-plugin-styled-components": "^2.1.4",
    "chromatic": "^11.20.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "only-allow": "^1.2.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.14",
    "style-dictionary": "^5.4.0",
    "styled-components": "^6.1.13",
    "stylelint": "^16.12.0",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-styled-components": "^0.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "styled-components",
    "figma",
    "code-connect",
    "ai-pdp-ds"
  ]
}
